# ---- declared inverses and symmetry ---------------------------------------

swr:symbolizes owl:inverseOf swr:symbolized-by .
swr:produces owl:inverseOf swr:produced-by .
swr:manifests-as owl:inverseOf swr:is-aspect-of .
swr:manifests-as owl:inverseOf swr:is-manifestation-of .
swr:synonym-of a owl:SymmetricProperty .
swr:manifests-as owl:inverseOf swr:aspect-of .
swr:manifests-as owl:inverseOf swr:is-dark-aspect-of .

